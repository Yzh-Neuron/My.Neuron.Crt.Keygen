@page "/"
@inject IJSRuntime JsRuntime

<style>
    body {
        background-color: #000000 !important;
        /* 科技网格 + 角落微弱径向光，夜间氛围感 */
        background-image: radial-gradient(circle at 20% 20%, rgba(100, 120, 255, 0.06) 0%, transparent 45%), radial-gradient(circle at 80% 80%, rgba(30, 140, 220, 0.05) 0%, transparent 45%), linear-gradient(rgba(70, 110, 220, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(70, 110, 220, 0.025) 1px, transparent 1px);
        background-size: 50px 50px;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0;
        padding: 20px;
    }

    .license-card {
        max-width: 780px;
        width: 100%;
        margin: 0 auto;
        /* 太空深紫蓝，夜间科技面板底色 */
        background-color: #141628;
        color: #e6edf7;
        border-radius: 20px;
        /* 混合蓝紫霓虹外发光 */
        box-shadow: 0 0 24px rgba(90,130,255,0.45), 0 0 48px rgba(120,80,220,0.28), 0 0 80px rgba(0,0,0,0.92);
        overflow: hidden;
        border: 1px solid rgba(110, 140, 255, 0.12);
    }

    .card-header-custom {
        background: transparent;
        padding: 26px 26px 18px 26px;
    }

    .card-body-custom {
        padding: 0 26px 26px 26px;
    }

    .title {
        color: #94bfff;
        font-weight: 700;
        font-size: 24px;
        margin: 0 0 6px 0;
        letter-spacing: 0.5px;
    }

    .subtitle {
        color: #8992b3;
        font-size: 13px;
        margin: 0;
    }

    .alert-box {
        background-color: rgba(255, 180, 40, 0.10);
        border: 1px solid rgba(255, 180, 40, 0.30);
        padding: 13px 16px;
        border-radius: 10px;
        margin-bottom: 26px;
        color: #ffd370;
        font-size: 14px;
    }

    .form-label {
        color: #c5d1ff;
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 10px;
        display: block;
    }

    .machine-textarea {
        width: 100%;
        background-color: #1c1f38;
        color: #e8edff;
        border: 1px solid rgba(90,120,220,0.28);
        border-radius: 10px;
        font-size: 15px;
        padding: 14px;
        resize: vertical;
        min-height: 120px;
        outline: none;
        transition: border 0.2s, box-shadow 0.2s;
    }

        .machine-textarea:focus {
            border-color: #5887ff;
            box-shadow: 0 0 0 2px rgba(88, 135, 255, 0.22), 0 0 12px rgba(88,135,255,0.15);
        }

    .btn-generate {
        width: 100%;
        background-color: #254edb;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-size: 17px;
        font-weight: 600;
        box-shadow: 0 0 20px rgba(37,78,219,0.65);
        cursor: pointer;
        transition: background 0.22s ease, box-shadow 0.22s ease;
    }

        .btn-generate:hover {
            background-color: #1d3fb8;
            box-shadow: 0 0 26px rgba(37,78,219,0.80);
        }

    .error-box {
        background-color: rgba(236, 64, 122, 0.11);
        border: 1px solid rgba(236, 64, 122, 0.30);
        padding: 13px 16px;
        border-radius: 10px;
        margin-bottom: 18px;
        color: #ff86a0;
        font-size: 14px;
    }

    .result-box {
        background-color: #132422;
        border: 1px solid rgba(40, 200, 160, 0.30);
        padding: 20px;
        border-radius: 12px;
    }

    .result-title {
        color: #62e8c4;
        margin: 0 0 14px 0;
        font-size: 16px;
        font-weight: 600;
    }

    .signature-pre {
        background-color: #0b1615;
        color: #7cf2cb;
        padding: 14px;
        border-radius: 8px;
        white-space: pre-wrap;
        word-break: break-all;
        font-size: 13px;
        max-height: 200px;
        overflow: auto;
        border: 1px solid rgba(40,200,160,0.20);
        margin: 0 0 18px 0;
    }

    .btn-copy {
        flex: 1;
        background-color: #232744;
        color: #d0d8f7;
        border: 1px solid rgba(100,130,240,0.25);
        border-radius: 10px;
        padding: 11px;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.22s ease;
    }

        .btn-copy:hover {
            background-color: #2c3154;
        }

    .btn-download {
        flex: 1;
        background-color: #0e9e83;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 11px;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.22s ease, box-shadow 0.22s ease;
    }

        .btn-download:hover {
            background-color: #0b826c;
            box-shadow: 0 0 14px rgba(14,158,131,0.45);
        }

    .button-row {
        display: flex;
        gap: 14px;
    }

   
</style>

<div class="license-card">
    <div class="card-header-custom">
        <h2 class="title">Neuron License Keygen</h2>
        <p class="subtitle">授权文件生成工具 · Neuron</p>
    </div>

    <div class="card-body-custom">
        <div class="alert-box">
            ⚠️ 请将生成好的 License.dat 放到软件根目录
        </div>

        <div class="mb-4">
            <label class="form-label">机器码 MachineCode</label>
            <textarea @bind="MachineCode" class="machine-textarea" rows="5" placeholder="粘贴客户端导出的机器码字符串"></textarea>
        </div>

        <button @onclick="Generate" class="btn-generate mb-4">
            🔐 生成License签名
        </button>

        @if (!string.IsNullOrEmpty(ErrorMsg))
        {
            <div class="error-box">@ErrorMsg</div>
        }

        @if (!string.IsNullOrEmpty(SignResult))
        {
            <div class="result-box">
                <h5 class="result-title">✅ 输出Base64签名</h5>
                <pre class="signature-pre">@SignResult</pre>

                <div class="button-row">
                    <button @onclick="CopySign" class="btn-copy">
                        📋 复制签名
                    </button>
                    <button @onclick="DownloadFile" class="btn-download">
                        💾 下载 license.dat
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string MachineCode { get; set; } = "";
    private string SignResult { get; set; } = "";
    private string ErrorMsg { get; set; } = "";

    private void Generate()
    {
        ErrorMsg = "";
        SignResult = "";
        if (string.IsNullOrWhiteSpace(MachineCode))
        {
            ErrorMsg = "请输入机器码";
            return;
        }
        try
        {
            SignResult = LicenseFileGeneratorBc.Sign(MachineCode);
        }
        catch (Exception ex)
        {
            ErrorMsg = ex.Message;
        }
    }

    private async Task CopySign()
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", SignResult);
    }

    private async Task DownloadFile()
    {
        string contentJs = System.Text.Json.JsonSerializer.Serialize(SignResult);
        string filenameJs = System.Text.Json.JsonSerializer.Serialize("license.dat");

        string script = $@"
            const blob=new Blob([{contentJs}],{{type:'text/plain'}});
            const url=URL.createObjectURL(blob);
            const a=document.createElement('a');
            a.href=url;
            a.download={filenameJs};
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        ";
        await JsRuntime.InvokeVoidAsync("eval", script);
    }
}
